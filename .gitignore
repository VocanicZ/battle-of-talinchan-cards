# Card audit — generated artifacts inside the extract-card-info skill
# (the skill's scripts/ are tracked; its audit/ output is not).
# Globbed so it matches every skill mirror (.skill/, .claude/skills/, .agents/skills/).
**/extract-card-info/audit/

# Tesseract.js language data cache (downloaded at runtime)
*.traineddata

# Godot consumer artifacts — the game vendors this repo as a submodule and
# imports images/, so Godot writes *.import sidecars (and a .godot/ cache)
# here. Generated per-machine, never source.
*.import
.godot/

# Local agent config (per-machine, not shared)
.claude/
.agents/

# Local scratch / audit tooling — one-off scripts and dumps, not source
/audit-counts.cjs
/check-rarity.cjs
/compare.cjs
/fix-enums.js
/compare-fields.ts
/list-limits.ts
/db-cards.json
/potential_limits.json
